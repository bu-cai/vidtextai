{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/process",
      "regex": "^/api/process(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/process(?:/)?$"
    },
    {
      "page": "/api/transcript",
      "regex": "^/api/transcript(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/transcript(?:/)?$"
    },
    {
      "page": "/api/youtube-info",
      "regex": "^/api/youtube\\-info(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/youtube\\-info(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/tools/blog",
      "regex": "^/tools/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tools/blog(?:/)?$"
    },
    {
      "page": "/tools/notes",
      "regex": "^/tools/notes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tools/notes(?:/)?$"
    },
    {
      "page": "/tools/shorts",
      "regex": "^/tools/shorts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tools/shorts(?:/)?$"
    },
    {
      "page": "/tools/summary",
      "regex": "^/tools/summary(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tools/summary(?:/)?$"
    },
    {
      "page": "/tools/transcript",
      "regex": "^/tools/transcript(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tools/transcript(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}